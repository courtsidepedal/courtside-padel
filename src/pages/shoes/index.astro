---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourtLine from '../../components/CourtLine.astro';
import RacketCard from '../../components/RacketCard.astro';

const shoes = (await getCollection('rackets', ({ data }) => !data.draft && data.gearType === 'shoes'))
  .sort((a, b) => (a.data.homepageRank ?? 99) - (b.data.homepageRank ?? 99));
---

<BaseLayout
  title="All Padel Shoe Reviews"
  description="Every padel shoe we've researched for grip, stability, and comfort on court — ranked and reviewed for every level."
>
  <header class="hub-head wrap">
    <p class="eyebrow">Gear reviews</p>
    <h1>All shoe reviews</h1>
    <p class="hub-sub">Grip, stability, and comfort researched against verified owner reviews.</p>
  </header>

  <CourtLine />

  <section class="wrap">
    {shoes.length > 0 ? (
      <div class="card-grid">
        {shoes.map((shoe) => (
          <RacketCard
            href={`/rackets/${shoe.id}/`}
            image={shoe.data.image}
            imageAlt={shoe.data.imageAlt}
            rank={shoe.data.homepageRank}
            category={shoe.data.category}
            level={shoe.data.level}
            title={shoe.data.title}
            weight={shoe.data.weight}
            balance={shoe.data.balance}
            bestFor={shoe.data.bestFor}
          />
        ))}
      </div>
    ) : (
      <p class="empty-note">No shoe reviews published yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hub-head {
    padding: 48px var(--gutter) 0;
  }

  .hub-head h1 {
    font-family: var(--font-display);
    font-size: 48px;
    text-transform: uppercase;
    margin-top: 12px;
  }

  .hub-sub {
    color: var(--muted-2);
    margin-top: 12px;
    font-size: 16px;
  }

  section {
    padding: 48px var(--gutter) 72px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .empty-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border: 1px dashed var(--line);
    padding: 24px;
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .hub-head h1 {
      font-size: 36px;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
