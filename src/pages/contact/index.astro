---
import BaseLayout from '../../layouts/BaseLayout.astro';

// Contact form posts to Web3Forms — no backend code to maintain, works on
// a fully static build, fits the "near-zero budget" constraint, AND
// supports a custom "thank you" redirect on its free plan (Formspree
// gates that behind a paid plan, which is why this isn't Formspree).
//
// TODO (one-time setup): go to https://web3forms.com, click "Create
// Access Key", enter an email, and you'll be emailed a key — no account
// signup required. Paste it below.
const WEB3FORMS_ACCESS_KEY = 'bdb2e89e-2a38-4a8a-b645-1abb33d8de19';

// TODO: once the custom domain is connected, update this to
// "https://yourdomain.com/contact/thanks/" — Web3Forms requires a full
// absolute URL here, so it can't auto-adjust between the .vercel.app
// preview domain and the real domain the way a relative path could.
const THANK_YOU_URL = 'https://courtside-padel.vercel.app/contact/thanks/';
---

<BaseLayout
  title="Contact"
  description="Questions, gear tips, or a racket you think we should look into? Get in touch with the Courtside Padel team."
>
  <div class="wrap contact-layout">
    <div class="contact-info">
      <p class="eyebrow">Get in touch</p>
      <h1>Questions, tips, or a racket we should look into?</h1>
      <p class="intro">We read everything, even if we can't reply to every message individually.</p>

      <div class="contact-channels">
        <div class="channel">
          <div class="ch-label">General inquiries</div>
          <a class="ch-value" href="mailto:hello@courtsidepadel.com">hello@courtsidepadel.com</a>
        </div>
        <div class="channel">
          <div class="ch-label">Brand &amp; affiliate partnerships</div>
          <a class="ch-value" href="mailto:partners@courtsidepadel.com">partners@courtsidepadel.com</a>
        </div>
      </div>
    </div>

    <div class="form-box">
      <h2>Send a message</h2>
      <form action="https://api.web3forms.com/submit" method="POST">
        <input type="hidden" name="access_key" value={WEB3FORMS_ACCESS_KEY} />
        <input type="hidden" name="subject" value="New message from Courtside Padel contact form" />
        <input type="hidden" name="from_name" value="Courtside Padel contact form" />
        <input type="hidden" name="redirect" value={THANK_YOU_URL} />
        {/* honeypot field — hidden from real visitors, catches basic spam bots */}
        <input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off" />

        <div class="field">
          <label for="name">Name</label>
          <input id="name" type="text" name="name" placeholder="Your name" required />
        </div>
        <div class="field">
          <label for="email">Email</label>
          <input id="email" type="email" name="email" placeholder="you@example.com" required />
        </div>
        <div class="field">
          <label for="topic">Topic</label>
          <select id="topic" name="topic">
            <option>General question</option>
            <option>Racket suggestion</option>
            <option>Correction / feedback</option>
            <option>Partnership inquiry</option>
          </select>
        </div>
        <div class="field">
          <label for="message">Message</label>
          <textarea id="message" name="message" placeholder="What's on your mind?" required></textarea>
        </div>
        <button class="btn-submit" type="submit">Send message</button>
      </form>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-layout {
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    gap: 56px;
    padding: 48px var(--gutter) 72px;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 38px;
    text-transform: uppercase;
    line-height: 1.05;
    margin: 14px 0 16px;
  }

  .intro {
    font-size: 15px;
    color: var(--muted-2);
    margin-bottom: 28px;
    max-width: 380px;
  }

  .contact-channels {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .channel {
    background: #fff;
    border: 1px solid var(--line);
    padding: 18px 20px;
  }

  .ch-label {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--court);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 4px;
  }

  .ch-value {
    display: block;
    font-size: 15px;
    font-weight: 600;
  }

  .ch-value:hover {
    color: var(--court);
  }

  .form-box {
    background: #fff;
    border: 1px solid var(--line);
    padding: 32px;
  }

  .form-box h2 {
    font-family: var(--font-display);
    font-size: 20px;
    text-transform: uppercase;
    margin-bottom: 20px;
  }

  .field {
    margin-bottom: 18px;
  }

  .field label {
    display: block;
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 6px;
  }

  .field input,
  .field select,
  .field textarea {
    width: 100%;
    border: 1px solid var(--line);
    padding: 12px;
    font-family: var(--font-body);
    font-size: 14px;
    background: var(--paper);
    color: var(--ink);
  }

  .field textarea {
    min-height: 120px;
    resize: vertical;
  }

  .btn-submit {
    background: var(--court);
    color: var(--paper);
    border: none;
    padding: 14px 28px;
    font-weight: 700;
    font-size: 14px;
    font-family: var(--font-body);
    cursor: pointer;
    transition: background 0.15s ease;
  }

  .btn-submit:hover {
    background: var(--ink);
  }

  @media (max-width: 800px) {
    .contact-layout {
      grid-template-columns: 1fr;
      gap: 40px;
    }
  }
</style>
