---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Message Sent"
  description="Thanks for getting in touch with Courtside Padel."
>
  <div class="wrap thanks">
    <p class="eyebrow">Message sent</p>
    <h1>Thanks — we've got it.</h1>
    <p class="body">
      We read every message, even if we can't reply to all of them individually. If it
      needs a response, we'll get back to you at the email you provided.
    </p>
    <a class="btn-back" href="/">&larr; Back to homepage</a>
  </div>
</BaseLayout>

<style>
  .thanks {
    padding: 96px var(--gutter) 120px;
    max-width: 560px;
    text-align: center;
    margin: 0 auto;
  }

  h1 {
    font-family: var(--font-display);
    font-size: 40px;
    text-transform: uppercase;
    margin: 14px 0 20px;
  }

  .body {
    font-size: 16px;
    color: var(--muted-2);
    margin-bottom: 32px;
  }

  .btn-back {
    display: inline-block;
    background: var(--ink);
    color: var(--paper);
    padding: 14px 24px;
    font-weight: 700;
    font-size: 14px;
    text-decoration: none;
  }

  .btn-back:hover {
    background: var(--court);
  }
</style>
