---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourtLine from '../../components/CourtLine.astro';
import RacketCard from '../../components/RacketCard.astro';

const rackets = (await getCollection('rackets', ({ data }) => !data.draft && data.gearType === 'racket'))
  .sort((a, b) => (a.data.homepageRank ?? 99) - (b.data.homepageRank ?? 99));
---

<BaseLayout
  title="All Racket Reviews"
  description="Every padel racket we've tested, ranked and reviewed with full spec breakdowns — power, control, and comfort models for every level."
>
  <header class="hub-head wrap">
    <p class="eyebrow">Gear reviews</p>
    <h1>All racket reviews</h1>
    <p class="hub-sub">Tested hands-on against real players, from beginner to advanced.</p>
  </header>

  <CourtLine />

  <section class="wrap">
    {rackets.length > 0 ? (
      <div class="card-grid">
        {rackets.map((racket) => (
          <RacketCard
            href={`/rackets/${racket.id}/`}
            image={racket.data.image}
            imageAlt={racket.data.imageAlt}
            rank={racket.data.homepageRank}
            category={racket.data.category}
            level={racket.data.level}
            title={racket.data.title}
            weight={racket.data.weight}
            balance={racket.data.balance}
            bestFor={racket.data.bestFor}
          />
        ))}
      </div>
    ) : (
      <p class="empty-note">No racket reviews published yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hub-head {
    padding: 48px var(--gutter) 0;
  }

  .hub-head h1 {
    font-family: var(--font-display);
    font-size: 48px;
    text-transform: uppercase;
    margin-top: 12px;
  }

  .hub-sub {
    color: var(--muted-2);
    margin-top: 12px;
    font-size: 16px;
  }

  section {
    padding: 48px var(--gutter) 72px;
  }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }

  .empty-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border: 1px dashed var(--line);
    padding: 24px;
  }

  @media (max-width: 900px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 620px) {
    .hub-head h1 {
      font-size: 36px;
    }

    .card-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
