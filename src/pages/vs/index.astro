---
import { getCollection, getEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CourtLine from '../../components/CourtLine.astro';

const comparisons = (await getCollection('comparisons', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());

const withRackets = await Promise.all(
  comparisons.map(async (cmp) => ({
    cmp,
    racketA: await getEntry(cmp.data.racketA),
    racketB: await getEntry(cmp.data.racketB),
  }))
);
---

<BaseLayout
  title="Racket Comparisons"
  description="Head-to-head padel racket comparisons, with verdicts broken down by player type."
>
  <header class="hub-head wrap">
    <p class="eyebrow">Head to head</p>
    <h1>All comparisons</h1>
    <p class="hub-sub">Two rackets, side by side, with a verdict for every type of player.</p>
  </header>

  <CourtLine />

  <section class="wrap">
    {withRackets.length > 0 ? (
      <ul class="cmp-list">
        {withRackets.map(({ cmp, racketA, racketB }) => (
          <li>
            <a href={`/vs/${cmp.id}/`}>
              <span class="cmp-title">{cmp.data.title}</span>
              <span class="cmp-sub">{racketA?.data.title} vs {racketB?.data.title}</span>
            </a>
          </li>
        ))}
      </ul>
    ) : (
      <p class="empty-note">No comparisons published yet.</p>
    )}
  </section>
</BaseLayout>

<style>
  .hub-head {
    padding: 48px var(--gutter) 0;
  }

  .hub-head h1 {
    font-family: var(--font-display);
    font-size: 48px;
    text-transform: uppercase;
    margin-top: 12px;
  }

  .hub-sub {
    color: var(--muted-2);
    margin-top: 12px;
    font-size: 16px;
  }

  section {
    padding: 48px var(--gutter) 72px;
  }

  .cmp-list {
    max-width: 760px;
  }

  .cmp-list li {
    border-top: 1px solid var(--line);
  }

  .cmp-list li:last-child {
    border-bottom: 1px solid var(--line);
  }

  .cmp-list a {
    display: block;
    padding: 20px 0;
  }

  .cmp-list a:hover .cmp-title {
    color: var(--court);
  }

  .cmp-title {
    display: block;
    font-family: var(--font-display);
    font-size: 22px;
    text-transform: uppercase;
  }

  .cmp-sub {
    display: block;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    margin-top: 6px;
  }

  .empty-note {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--muted);
    border: 1px dashed var(--line);
    padding: 24px;
  }

  @media (max-width: 620px) {
    .hub-head h1 {
      font-size: 36px;
    }
  }
</style>
