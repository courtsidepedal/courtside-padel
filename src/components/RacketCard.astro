---
interface Props {
  href: string;
  image: string;
  imageAlt?: string;
  rank?: number;
  category: string;
  level: string;
  title: string;
  weight?: string;
  balance?: string;
  bestFor?: string;
}

const { href, image, imageAlt, rank, category, level, title, weight, balance, bestFor } =
  Astro.props;
---

<a href={href} class="card">
  <div class="card-img">
    <img src={image} alt={imageAlt ?? title} width="400" height="280" loading="lazy" />
    {rank && <div class="rank-badge">{rank}</div>}
  </div>
  <div class="card-body">
    <div class="card-cat">{category} &middot; {level}</div>
    <h3>{title}</h3>
    {weight && (
      <div class="spec-row"><span>Weight</span><span>{weight}</span></div>
    )}
    {balance && (
      <div class="spec-row"><span>Balance</span><span>{balance}</span></div>
    )}
    {bestFor && (
      <div class="spec-row"><span>Best for</span><span>{bestFor}</span></div>
    )}
  </div>
</a>

<style>
  .card {
    background: #fff;
    border: 1px solid var(--line);
    display: block;
    transition: border-color 0.15s ease;
  }

  .card:hover {
    border-color: var(--court);
  }

  .card-img {
    height: 180px;
    background: var(--charcoal);
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
  }

  .card-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .rank-badge {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--ball);
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 13px;
    width: 28px;
    height: 28px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-body {
    padding: 20px;
  }

  .card-cat {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--court);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 8px;
  }

  .card-body h3 {
    font-size: 19px;
    margin-bottom: 10px;
    color: var(--ink);
  }

  .spec-row {
    display: flex;
    justify-content: space-between;
    font-size: 12px;
    color: var(--muted);
    padding: 6px 0;
    border-top: 1px solid var(--line);
    font-family: var(--font-mono);
  }

  .spec-row span:last-child {
    color: var(--ink);
    font-weight: 500;
  }
</style>
